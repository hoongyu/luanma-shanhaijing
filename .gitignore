__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
node_modules/
.env

# 字体原件不进仓库：体积大且可从上游重新下载。
# 子集化产物由构建脚本生成，也不进仓库。
prototype/fonts/*.ttf
prototype/fonts/*.otf
prototype/fonts/*.zip
prototype/fonts/sub-*.woff2
prototype/fonts/ui-*.woff2
# 用 fonts/source/* 而不是 fonts/source/：父目录被整个排除后 git 不会下降进去，
# 负向规则会失效，占位符只能靠 git add -f 硬塞。写成通配才能让 !.gitkeep 生效。
fonts/source/*
!fonts/source/.gitkeep
public/fonts/

# 授权原文必须进仓库 —— OFL 要求随分发附带
!fonts/LICENSES/
